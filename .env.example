# Connection string do Postgres. Na Vercel, ao criar um banco (Storage > Create Database > Postgres),
# essa variável é preenchida automaticamente ao conectar o banco ao projeto.
POSTGRES_URL=postgresql://usuario:senha@host:5432/banco

# Chave usada para assinar o cookie de sessão. Gere uma string aleatória própria em produção,
# por exemplo com: openssl rand -base64 32
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa

# Opcional: chave da Resend (resend.com) para enviar o e-mail de "esqueci minha senha".
# Sem isso, o link de redefinição aparece direto na tela (modo de desenvolvimento).
RESEND_API_KEY=
RESEND_FROM=Data da Virada <onboarding@resend.dev>
